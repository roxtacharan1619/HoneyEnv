# Discord webhook URL for canary trigger notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Canary listener configuration
CANARY_HOST=127.0.0.1
CANARY_PORT=8080

# Optional public URL (e.g. from ngrok) for external testing
# CANARY_PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
